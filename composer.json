{
    "name": "cargopulse/cargopulse",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^10.0",
        "laravel/passport": "^11.0",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/dusk": "^10.0",
        "laravel/telescope": "^11.0",
        "pestphp/pest": "^2.0",
        "pestphp/laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    }
}